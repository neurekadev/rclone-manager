# --[ RCLONE MANAGER ]---------------------------------------------------------
# Required rclone remote and optional path, for example: infinidysk: or s3:media
RCLONE_REMOTE=REPLACE_ME:

# Stable rclone version (for example 1.74.2), or latest for the newest release.
RCLONE_VERSION=latest

# Absolute path where rclone-manager owns and supervises the FUSE mount.
RCLONE_MOUNTPOINT=/mnt/rclone

# Time allowed for graceful rclone shutdown before forced cleanup and SIGKILL.
RCLONE_MANAGER_SHUTDOWN_TIMEOUT=30s

# All native RCLONE_* vars are supported except RCLONE_DAEMON.
